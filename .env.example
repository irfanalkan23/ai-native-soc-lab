# AI-Native SOC & Agentic Security Engineering Lab
# Configuration Template (.env.example)
#
# DO NOT COMMIT REAL CREDENTIALS OR API KEYS.
# This file is a reference and configuration template only.
#
# IMPORTANT NOTICE FOR JIRA CLOUD & RUNTIME CONFIGURATION:
# Jira integration and smoke tests read configuration strictly from os.environ.
# Python-dotenv is NOT used. Copying this file to .env alone does NOT cause
# Jira configuration to load into the process environment.
# Real Jira values must be exported/set directly in your process environment:
#   Linux/macOS: export JIRA_BASE_URL="https://your-domain.atlassian.net"
#   PowerShell:  $env:JIRA_BASE_URL = "https://your-domain.atlassian.net"
# Real credentials must remain uncommitted.

# -----------------------------------------------------------------------
# OpenAI provider (Milestone 3B-2)
# -----------------------------------------------------------------------
# Obtain a restricted API key with Write access to /v1/responses only.
# Never share or commit the real key.
OPENAI_API_KEY=
OPENAI_MODEL=

# -----------------------------------------------------------------------
# Splunk (Milestone 2 — local lab only)
# -----------------------------------------------------------------------
# SPLUNK_HOST=
# SPLUNK_PORT=
# SPLUNK_TOKEN=

# -----------------------------------------------------------------------
# Jira Cloud API (Milestone 5B-2)
# -----------------------------------------------------------------------
# Downstream external tracking/reporting sink. Read strictly from os.environ.
# Copying to .env alone does not load these values. Export them in your shell.
# Do not commit real credentials.
JIRA_BASE_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=

# -----------------------------------------------------------------------
# Future / planned integrations
# -----------------------------------------------------------------------
# THREAT_INTEL_API_KEY=
